<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tvskip"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/fancyresturent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#74454545"

        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"

        android:layout_marginTop="60dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="30dp"
        android:orientation="vertical" >

        <ImageView
            android:id="@+id/imgview"
            android:layout_width="146dp"
            android:layout_height="242dp"
            android:layout_marginLeft="100dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="100dp"
            android:backgroundTint="@color/black"
            android:padding="8dp"
            app:srcCompat="@drawable/foodlogo"
            app:tint="#F2FFFFFF" />

        <TextView
            android:id="@+id/cafehouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="cursive"
            android:gravity="center"
            android:padding="8dp"
            android:text="Cafe House"
            android:textColor="#F5FFFFFF"
            android:textColorLink="#FEFFFFFF"
            android:textSize="60sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/bn1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/butn_gradient"
            android:backgroundTint="@null"
            android:padding="8dp"
            android:text="login"
            android:textColor="#FBF6F6"
            android:textColorLink="#FFFCFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/butn_gradient"
            android:backgroundTint="@null"
            android:padding="8dp"
            android:text="Register"
            android:textColor="#FBF6F6"
            android:textColorLink="#FFFCFC"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>



</RelativeLayout>